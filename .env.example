# Заполните только в локальном файле .env (chmod 600).
BOT_TOKEN=
# Числовой ID владельца. Если пусто, привязка кодом из терминала.
OWNER_TELEGRAM_ID=
# Публичный HTTPS-адрес Mini App на вашем сервере
MINI_APP_URL=
# Для временной кнопки на Mac установите cloudflared и укажите cloudflare.
MINI_APP_TUNNEL=
WEB_HOST=127.0.0.1
WEB_PORT=8787
# IMAP по TLS. Укажите ящик/папку, куда ИСУ доставляет уведомления.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Список адресов или доменов через запятую. * означает весь указанный ящик/папку.
MAIL_SENDERS=isu.ifmo.ru,isu.itmo.ru
# Для Microsoft 365 с разрешённым IMAP OAuth вместо IMAP_PASSWORD:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
